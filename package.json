{
  "name": "dsh-opencode-eyes",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: gives a text-only model eyes. It mounts the bundled opencode-eyes MCP server, which sends an image file to StepFun's step-3.7-flash vision model and returns a detailed description, as the tool mcp__opencode_eyes__describe_image.",
  "type": "module",
  "license": "MIT",
  "author": "bauerelizabeth07139",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauerelizabeth07139/opencode-eyes.git"
  },
  "homepage": "https://github.com/bauerelizabeth07139/opencode-eyes#readme",
  "bugs": {
    "url": "https://github.com/bauerelizabeth07139/opencode-eyes/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "assets",
    "test",
    "README.md",
    "LICENSE",
    "src",
    "pyproject.toml",
    "requirements.txt"
  ],
  "engines": {
    "node": ">=22",
    "python": ">=3.8",
    "dsh": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "icon": "./assets/icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/plugin.test.mjs && node --import ./test/hooks.mjs test/mount.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "vision",
    "image",
    "describe-image",
    "stepfun"
  ]
}
